<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BaseThemeLight" parent="@android:style/Theme.Holo.Light.NoActionBar">
        <item name="appSelectableItemBackground">?android:attr/selectableItemBackground</item>
        <item name="android:actionMenuTextColor">@android:color/black</item>
        <item name="android:textAppearanceLargePopupMenu">@style/LargeMenuText</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/LargeMenuText</item>
        <item name="android:popupMenuStyle">@style/CustomPopupMenu</item>
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_thumb</item>
        <item name="android:scrollbarTrackVertical">@drawable/scrollbar_track</item>
        <item name="android:scrollbarSize">10dp</item>
        <item name="android:fastScrollThumbDrawable">@drawable/fastscroll_thumb</item>
    </style>

    <style name="BaseThemeDark" parent="@android:style/Theme.Holo.NoActionBar">
        <item name="appSelectableItemBackground">?android:attr/selectableItemBackground</item>
        <item name="android:actionMenuTextColor">@android:color/black</item>
        <item name="android:textAppearanceLargePopupMenu">@style/LargeMenuText</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/LargeMenuText</item>
        <item name="android:popupMenuStyle">@style/CustomPopupMenu</item>
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_thumb</item>
        <item name="android:scrollbarTrackVertical">@drawable/scrollbar_track</item>
        <item name="android:scrollbarSize">10dp</item>
        <item name="android:fastScrollThumbDrawable">@drawable/fastscroll_thumb</item>
    </style>

    <style name="AppThemeLight" parent="BaseThemeLight">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/black</item>
        <item name="android:textColorTertiary">@android:color/black</item>

        <item name="searchColor">@android:color/black</item>
        <item name="resultColor">@android:color/black</item>
        <item name="resultShadowColor">@android:color/transparent</item>
        <item name="listBackgroundColor">@android:color/white</item>
        <item name="searchBackgroundColor">@android:color/white</item>
        <item name="searchBackgroundOutline">@android:color/black</item>
        <item name="dividerDrawable">@drawable/list_separator_dotted</item>
        <item name="textShadowRadius">0</item>
    </style>

    <style name="AppThemeDark" parent="BaseThemeDark">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:textColor">@color/kiss_text_on_dark</item>
        <item name="android:textColorSecondary">@android:color/white</item>

        <item name="searchColor">@android:color/white</item>
        <item name="resultColor">@color/kiss_text_on_dark</item>
        <item name="resultShadowColor">@android:color/black</item>
        <item name="listBackgroundColor">@color/kiss_list_background_inverse</item>

        <item name="searchBackgroundColor">@color/kiss_list_background_inverse</item>
        <item name="searchBackgroundOutline">@android:color/black</item>
        <item name="dividerDrawable">@drawable/list_separator_dark</item>
        <item name="textShadowRadius">0</item>
    </style>


    <style name="AppThemeAmoledDark" parent="BaseThemeDark">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:textColor">@color/kiss_text_on_dark</item>
        <item name="android:textColorSecondary">@android:color/white</item>

        <item name="searchColor">@android:color/white</item>
        <item name="resultColor">@android:color/white</item>
        <item name="resultShadowColor">@android:color/black</item>
        <item name="listBackgroundColor">@android:color/black</item>
        <item name="searchBackgroundOutline">@android:color/black</item>
        <item name="searchBackgroundColor">@android:color/black</item>

        <item name="dividerDrawable">@null</item>
        <item name="textShadowRadius">0</item>
    </style>

    <style name="SettingThemeAmoledDark" parent="SettingThemeDark">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:textColor">@color/kiss_text_on_dark</item>
        <item name="android:textColorSecondary">#7f7f7f</item>
        <!-- Mudita Mindful Design: Custom switch style -->
        <item name="android:switchStyle">@style/MuditaSwitch</item>
    </style>

    <style name="AppThemeTransparent" parent="AppThemeLight">
        <item name="resultColor">@android:color/black</item>
        <item name="resultShadowColor">@android:color/transparent</item>
        <item name="listBackgroundColor">@android:color/white</item>
        <item name="dividerDrawable">@drawable/list_separator_dotted</item>
        <item name="textShadowRadius">0</item>
    </style>

    <style name="AppThemeSemiTransparent" parent="AppThemeLight">
        <item name="android:textColorSecondary">@android:color/black</item>
        <item name="resultShadowColor">@android:color/transparent</item>
        <item name="dividerDrawable">@drawable/list_separator_dotted</item>
        <item name="listBackgroundColor">@android:color/white</item>
        <item name="searchBackgroundColor">@android:color/white</item>
        <item name="textShadowRadius">0</item>
    </style>

    <style name="AppThemeSemiTransparentDark" parent="AppThemeDark">
        <item name="resultColor">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/black</item>
        <item name="dividerDrawable">@drawable/list_separator_dotted</item>
        <item name="listBackgroundColor">@android:color/white</item>
        <item name="searchBackgroundColor">@android:color/white</item>
        <item name="textShadowRadius">0</item>
    </style>

    <style name="AppThemeTransparentDark" parent="AppThemeDark">
        <item name="listBackgroundColor">@android:color/white</item>
        <item name="dividerDrawable">@drawable/list_separator_dotted</item>
        <item name="textShadowRadius">0</item>
    </style>

    <style name="SettingTheme" parent="AppThemeLight">
        <item name="android:windowActionBar">true</item>
        <item name="android:windowNoTitle">false</item>
        <item name="android:windowBackground">@color/kiss_background</item>
        <item name="android:textColorSecondary">@android:color/black</item>
        <item name="android:textAppearanceLarge">@style/LargePreferenceText</item>
        <item name="android:textAppearanceMedium">@style/LargePreferenceSummaryText</item>
        <item name="android:textAppearanceListItem">@style/LargePreferenceText</item>
        <item name="android:textAppearanceListItemSmall">@style/LargePreferenceSummaryText</item>
        <!-- Mudita Mindful Design: Custom switch style -->
        <item name="android:switchStyle">@style/MuditaSwitch</item>
        <!-- Mudita: Black preference category headers -->
        <item name="android:preferenceCategoryStyle">@style/MuditaPreferenceCategory</item>
        <!-- Mudita: Dotted list divider -->
        <item name="android:listDivider">@drawable/list_separator_dotted</item>
    </style>

    <!-- Mudita Mindful Design: Switch style for e-ink
         Specs: 48x24dp track, 16dp thumb, 1dp border, 12dp corner radius -->
    <style name="MuditaSwitch">
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:switchMinWidth">48dp</item>
        <item name="android:switchPadding">4dp</item>
        <item name="android:thumbTextPadding">4dp</item>
        <item name="android:showText">false</item>
        <item name="android:textOn"></item>
        <item name="android:textOff"></item>
    </style>

    <style name="SettingThemeDark" parent="AppThemeDark">
        <item name="android:windowActionBar">true</item>
        <item name="android:windowNoTitle">false</item>
        <item name="android:windowBackground">@color/kiss_list_background_inverse</item>
        <item name="android:textColorSecondary">@android:color/black</item>
        <item name="android:textAppearanceLarge">@style/LargePreferenceText</item>
        <item name="android:textAppearanceMedium">@style/LargePreferenceSummaryText</item>
        <item name="android:textAppearanceListItem">@style/LargePreferenceText</item>
        <item name="android:textAppearanceListItemSmall">@style/LargePreferenceSummaryText</item>
        <!-- Mudita Mindful Design: Custom switch style -->
        <item name="android:switchStyle">@style/MuditaSwitch</item>
        <!-- Mudita: Black preference category headers -->
        <item name="android:preferenceCategoryStyle">@style/MuditaPreferenceCategory</item>
        <!-- Mudita: Dotted list divider -->
        <item name="android:listDivider">@drawable/list_separator_dotted</item>
    </style>

    <style name="OverlayShadowDisabled">
        <item name="textShadowRadius">0</item>
    </style>
    <style name="OverlayShadowEnabled">
        <item name="textShadowRadius">0</item>
    </style>

    <style name="OverlaySeparatorDisabled">
        <item name="dividerDrawable">@null</item>
    </style>
    <style name="OverlaySeparatorLight">
        <item name="dividerDrawable">@drawable/list_separator_dotted</item>
    </style>
    <style name="OverlaySeparatorDark">
        <item name="dividerDrawable">@drawable/list_separator_dark</item>
    </style>

    <style name="OverlayResultColorLight">
        <item name="resultColor">@android:color/black</item>
    </style>
    <style name="OverlayResultColorSemiLight">
        <item name="resultColor">@android:color/black</item>
    </style>
    <style name="OverlayResultColorDark">
        <item name="resultColor">@color/kiss_text_on_dark</item>
    </style>
    <style name="OverlayResultColorSemiDark">
        <item name="resultColor">@color/kiss_text_on_semi_dark</item>
    </style>
    <style name="OverlayResultColorBlack">
        <item name="resultColor">@android:color/white</item>
    </style>


    <style name="OverlayWallpaperEnabled">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
    </style>
    <style name="OverlayWallpaperDisabled">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <style name="OverlayResultSizeLargest">
        <item name="resultHeight">@dimen/result_height_largest</item>
        <item name="resultIconSize">@dimen/result_icon_size_largest</item>
        <item name="resultSubIconSize">@dimen/result_subicon_size_largest</item>
        <item name="resultNotificationDotSize">@dimen/result_notification_dot_size_largest</item>
        <item name="resultTitleSize">@dimen/result_title_size_largest</item>
        <item name="resultSubtitleSize">@dimen/result_subtitle_size_largest</item>
        <item name="resultButtonHeight">@dimen/result_icon_size_largest</item>
    </style>

    <style name="OverlayResultSizeLarge">
        <item name="resultHeight">@dimen/result_height_large</item>
        <item name="resultIconSize">@dimen/result_icon_size_large</item>
        <item name="resultSubIconSize">@dimen/result_subicon_size_large</item>
        <item name="resultNotificationDotSize">@dimen/result_notification_dot_size_large</item>
        <item name="resultTitleSize">@dimen/result_title_size_large</item>
        <item name="resultSubtitleSize">@dimen/result_subtitle_size_large</item>
        <item name="resultButtonHeight">@dimen/result_icon_size_large</item>
    </style>
    
    <style name="OverlayResultSizeStandard">
        <item name="resultHeight">@dimen/result_height</item>
        <item name="resultIconSize">@dimen/result_icon_size</item>
        <item name="resultSubIconSize">@dimen/result_subicon_size</item>
        <item name="resultNotificationDotSize">@dimen/result_notification_dot_size</item>
        <item name="resultTitleSize">@dimen/result_title_size</item>
        <item name="resultSubtitleSize">@dimen/result_subtitle_size</item>
        <item name="resultButtonHeight">@dimen/result_icon_size</item>
    </style>

    <style name="OverlayResultSizeMedium">
        <item name="resultHeight">@dimen/result_height_medium</item>
        <item name="resultIconSize">@dimen/result_icon_size_medium</item>
        <item name="resultSubIconSize">@dimen/result_subicon_size_medium</item>
        <item name="resultNotificationDotSize">@dimen/result_notification_dot_size_medium</item>
        <item name="resultTitleSize">@dimen/result_title_size_medium</item>
        <item name="resultSubtitleSize">@dimen/result_subtitle_size_medium</item>
        <item name="resultButtonHeight">@dimen/result_icon_size_medium</item>
    </style>

    <style name="OverlayResultSizeSmall">
        <item name="resultHeight">@dimen/result_height_small</item>
        <item name="resultIconSize">@dimen/result_icon_size_small</item>
        <item name="resultSubIconSize">@dimen/result_subicon_size_small</item>
        <item name="resultNotificationDotSize">@dimen/result_notification_dot_size_small</item>
        <item name="resultTitleSize">@dimen/result_title_size_small</item>
        <item name="resultSubtitleSize">@dimen/result_subtitle_size_small</item>
        <item name="resultButtonHeight">@dimen/result_icon_size_small</item>
    </style>

    <style name="OverlayResultSizeSmallest">
        <item name="resultHeight">@dimen/result_height_smallest</item>
        <item name="resultIconSize">@dimen/result_icon_size_smallest</item>
        <item name="resultSubIconSize">@dimen/result_subicon_size_smallest</item>
        <item name="resultNotificationDotSize">@dimen/result_notification_dot_size_smallest</item>
        <item name="resultTitleSize">@dimen/result_title_size_smallest</item>
        <item name="resultSubtitleSize">@dimen/result_subtitle_size_smallest</item>
        <item name="resultButtonHeight">@dimen/result_icon_size_smallest</item>
    </style>

    <style name="OverlayResultSizeNoIcons">
        <item name="resultIconSize">?attr/resultNotificationDotSize</item>
    </style>

    <style name="OverlayBarColorLight">
        <item name="searchBackgroundColor">@android:color/white</item>
    </style>
    <style name="OverlayBarColorSemiLight">
        <item name="searchBackgroundColor">@color/kiss_background_light_transparent</item>
    </style>
    <style name="OverlayBarColorDark">
        <item name="searchBackgroundColor">@color/kiss_list_background_inverse</item>
    </style>
    <style name="OverlayBarColorSemiDark">
        <item name="searchBackgroundColor">@color/kiss_background_dark_transparent</item>
    </style>
    <style name="OverlayBarColorBlack">
        <item name="searchBackgroundColor">@android:color/black</item>
    </style>

    <!-- E-ink optimized theme -->
    <style name="AppThemeEink" parent="BaseThemeLight">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/black</item>
        <item name="android:textColorTertiary">@android:color/black</item>

        <item name="searchColor">@android:color/black</item>
        <item name="resultColor">@android:color/black</item>
        <item name="resultShadowColor">@android:color/transparent</item>
        <item name="listBackgroundColor">@android:color/white</item>
        <item name="searchBackgroundColor">@android:color/white</item>
        <item name="searchBackgroundOutline">@android:color/black</item>
        <item name="dividerDrawable">@drawable/list_separator_dotted</item>
        <item name="textShadowRadius">0</item>
    </style>
</resources>
